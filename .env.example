# Banco de dados
DATABASE_URL=postgres://vendedorpro:postgres@localhost:5432/vendedorpro

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Senhas
SALT_ROUNDS=10

# Rate limiting (req / min por IP)
RATE_LIMIT=5

# CORS
CORS_ORIGIN=http://localhost:3000

# App
PORT_API=4000
PORT_WEB=3000
NODE_ENV=development

# Stripe (Fase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail (Fase 5)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VendedorPro <noreply@vendedorpro.com>