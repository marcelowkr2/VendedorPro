{
  "name": "vendedorpro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "cd apps/api && pnpm dev",
    "dev:web": "cd apps/web && pnpm dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "cd packages/db && pnpm db:generate",
    "db:migrate": "cd packages/db && pnpm db:migrate",
    "db:push": "cd packages/db && pnpm db:push",
    "db:seed": "cd packages/db && pnpm db:seed",
    "start:api": "cd apps/api && pnpm start",
    "start:web": "cd apps/web && pnpm start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "rm -rf node_modules .turbo dist build .next apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "turbo": "^2.2.0",
    "typescript": "^5.7.0",
    "prettier": "^3.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5"
  }
}