{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@vendedorpro/shared": ["packages/shared/src"],
      "@vendedorpro/shared/*": ["packages/shared/src/*"],
      "@vendedorpro/config": ["packages/config/src"],
      "@vendedorpro/config/*": ["packages/config/src/*"],
      "@vendedorpro/db": ["packages/db/src"],
      "@vendedorpro/db/*": ["packages/db/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.json"],
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}